// 简单使用示例

fn main {
  println("=== Black-Box Optimization 使用示例 ===")
  println("")

  let dim = 3
  let bounds = @lib.make_bounds(-5.0, 5.0)
  let rng = @lib.make_rng(123.0)

  println("1. 运行随机搜索算法:")
  let rs_config = @lib.make_random_search_config(1000, dim, bounds)
  let rs_result = @lib.random_search(rs_config, @lib.sphere_function, rng)
  println("   最优值: \{rs_result.best_value}")
  println("   评估次数: \{rs_result.evaluations}")
  println("")

  println("2. 运行爬山法算法:")
  let hc_config = @lib.make_hill_climbing_config(1000, dim, bounds, 0.5, 10)
  let hc_result = @lib.hill_climbing(hc_config, @lib.sphere_function, rng)
  println("   最优值: \{hc_result.best_value}")
  println("   评估次数: \{hc_result.evaluations}")
  println("")

  println("3. 运行模拟退火算法:")
  let sa_config = @lib.make_simulated_annealing_config(1000, dim, bounds, 100.0, 0.995, 0.5)
  let sa_result = @lib.simulated_annealing(sa_config, @lib.sphere_function, rng)
  println("   最优值: \{sa_result.best_value}")
  println("   评估次数: \{sa_result.evaluations}")
  println("")

  println("4. 运行交叉熵方法 (CEM):")
  let cem_config = @lib.make_cem_config(1000, dim, bounds, 100, 0.1, 0.7)
  let cem_result = @lib.cross_entropy_method(cem_config, @lib.sphere_function, rng)
  println("   最优值: \{cem_result.best_value}")
  println("   评估次数: \{cem_result.evaluations}")
  println("")

  println("5. 运行灰狼优化 (GWO):")
  let gwo_config = @lib.make_gwo_config(1000, dim, bounds, 25)
  let gwo_result = @lib.grey_wolf_optimizer(gwo_config, @lib.sphere_function, rng)
  println("   最优值: \{gwo_result.best_value}")
  println("   评估次数: \{gwo_result.evaluations}")
  println("")

  println("6. 运行 Hooke-Jeeves 模式搜索:")
  let hj_config = @lib.make_hooke_jeeves_config(1000, dim, bounds, 0.5, 0.5, 1.0e-6)
  let hj_result = @lib.hooke_jeeves(hj_config, @lib.sphere_function, rng)
  println("   最优值: \{hj_result.best_value}")
  println("   评估次数: \{hj_result.evaluations}")
  println("")

  println("7. 运行鲸群优化 (WOA):")
  let woa_config = @lib.make_woa_config(1000, dim, bounds, 25, 1.0)
  let woa_result = @lib.whale_optimization(woa_config, @lib.sphere_function, rng)
  println("   最优值: \{woa_result.best_value}")
  println("   评估次数: \{woa_result.evaluations}")
  println("")

  println("8. 运行蝙蝠算法 (Bat Algorithm):")
  let bat_config = @lib.make_bat_config(1000, dim, bounds, 25, 0.0, 1.0, 0.5, 1.0)
  let bat_result = @lib.bat_algorithm(bat_config, @lib.sphere_function, rng)
  println("   最优值: \{bat_result.best_value}")
  println("   评估次数: \{bat_result.evaluations}")
  println("")

  println("9. 运行和声搜索 (Harmony Search):")
  let hs_config = @lib.make_hs_config(1000, dim, bounds, 20, 0.9, 0.3, 0.05)
  let hs_result = @lib.harmony_search(hs_config, @lib.sphere_function, rng)
  println("   最优值: \{hs_result.best_value}")
  println("   评估次数: \{hs_result.evaluations}")
  println("")

  println("10. 运行正弦余弦算法 (SCA):")
  let sca_config = @lib.make_sca_config(1000, dim, bounds, 25)
  let sca_result = @lib.sine_cosine_algorithm(sca_config, @lib.sphere_function, rng)
  println("   最优值: \{sca_result.best_value}")
  println("   评估次数: \{sca_result.evaluations}")
  println("")

  println("11. 运行飞蛾火焰优化 (MFO):")
  let mfo_config = @lib.make_mfo_config(1000, dim, bounds, 25, 1.0)
  let mfo_result = @lib.moth_flame_optimization(mfo_config, @lib.sphere_function, rng)
  println("   最优值: \{mfo_result.best_value}")
  println("   评估次数: \{mfo_result.evaluations}")
  println("")

  println("12. 运行蚁狮优化 (ALO):")
  let alo_config = @lib.make_alo_config(1000, dim, bounds, 25)
  let alo_result = @lib.antlion_optimizer(alo_config, @lib.sphere_function, rng)
  println("   最优值: \{alo_result.best_value}")
  println("   评估次数: \{alo_result.evaluations}")
  println("")

  println("13. 运行麻雀搜索算法 (SSA):")
  let ssa_config = @lib.make_ssa_config(1000, dim, bounds, 25)
  let ssa_result = @lib.sparrow_search_algorithm(ssa_config, @lib.sphere_function, rng)
  println("   最优值: \{ssa_result.best_value}")
  println("   评估次数: \{ssa_result.evaluations}")
  println("")

  println("14. 运行哈里斯鹰优化 (HHO):")
  let hho_config = @lib.make_hho_config(1000, dim, bounds, 25)
  let hho_result = @lib.harris_hawks_optimization(hho_config, @lib.sphere_function, rng)
  println("   最优值: \{hho_result.best_value}")
  println("   评估次数: \{hho_result.evaluations}")
  println("")

  println("15. 运行花粉传播算法 (FPA):")
  let fpa_config = @lib.make_fpa_config(1000, dim, bounds, 25)
  let fpa_result = @lib.flower_pollination_algorithm(fpa_config, @lib.sphere_function, rng)
  println("   最优值: \{fpa_result.best_value}")
  println("   评估次数: \{fpa_result.evaluations}")
  println("")

  println("16. 运行蜻蜓算法 (DA):")
  let da_config = @lib.make_da_config(1000, dim, bounds, 25)
  let da_result = @lib.dragonfly_algorithm(da_config, @lib.sphere_function, rng)
  println("   最优值: \{da_result.best_value}")
  println("   评估次数: \{da_result.evaluations}")
  println("")

  println("17. 运行入侵杂草优化 (IWO):")
  let iwo_config = @lib.make_iwo_config(1000, dim, bounds, 10, 40, 1, 5, 2.0, 0.1, 3.0)
  let iwo_result = @lib.invasive_weed_optimization(iwo_config, @lib.sphere_function, rng)
  println("   最优值: \{iwo_result.best_value}")
  println("   评估次数: \{iwo_result.evaluations}")
  println("")

  println("18. 运行细菌觅食优化 (BFO):")
  let bfo_config = @lib.make_bfo_config(1000, dim, bounds, 25, 5, 3, 0.2)
  let bfo_result = @lib.bacteria_foraging_optimization(bfo_config, @lib.sphere_function, rng)
  println("   最优值: \{bfo_result.best_value}")
  println("   评估次数: \{bfo_result.evaluations}")
  println("")

  println("19. 运行混合蛙跳算法 (SFLA):")
  let sfla_config = @lib.make_sfla_config(1000, dim, bounds, 30, 5, 10)
  let sfla_result = @lib.shuffled_frog_leaping_algorithm(sfla_config, @lib.sphere_function, rng)
  println("   最优值: \{sfla_result.best_value}")
  println("   评估次数: \{sfla_result.evaluations}")
  println("")

  println("20. 运行萤火虫群优化 (GSO):")
  let gso_config = @lib.make_gso_config(1000, dim, bounds, 25, 0.4, 0.6, 5, 5.0, 1.0)
  let gso_result = @lib.glowworm_swarm_optimization(gso_config, @lib.sphere_function, rng)
  println("   最优值: \{gso_result.best_value}")
  println("   评估次数: \{gso_result.evaluations}")
  println("")

  println("21. 运行引力搜索算法 (GSA):")
  let gsa_config = @lib.make_gsa_config(1000, dim, bounds, 25, 100.0, 0.99)
  let gsa_result = @lib.gravitational_search_algorithm(gsa_config, @lib.sphere_function, rng)
  println("   最优值: \{gsa_result.best_value}")
  println("   评估次数: \{gsa_result.evaluations}")
  println("")

  println("22. 运行教与学优化 (TLBO):")
  let tlbo_config = @lib.make_tlbo_config(1000, dim, bounds, 30)
  let tlbo_result = @lib.teaching_learning_based_optimization(tlbo_config, @lib.sphere_function, rng)
  println("   最优值: \{tlbo_result.best_value}")
  println("   评估次数: \{tlbo_result.evaluations}")
  println("")

  println("23. 运行动物迁徙优化 (AMO):")
  let amo_config = @lib.make_amo_config(1000, dim, bounds, 25, 5)
  let amo_result = @lib.animal_migration_optimization(amo_config, @lib.sphere_function, rng)
  println("   最优值: \{amo_result.best_value}")
  println("   评估次数: \{amo_result.evaluations}")
  println("")

  println("24. 运行多宇宙优化 (MVO):")
  let mvo_config = @lib.make_mvo_config(1000, dim, bounds, 25)
  let mvo_result = @lib.multi_verse_optimizer(mvo_config, @lib.sphere_function, rng)
  println("   最优值: \{mvo_result.best_value}")
  println("   评估次数: \{mvo_result.evaluations}")
  println("")

  println("25. 运行磷虾群算法 (KH):")
  let kh_config = @lib.make_kh_config(1000, dim, bounds, 25)
  let kh_result = @lib.krill_herd(kh_config, @lib.sphere_function, rng)
  println("   最优值: \{kh_result.best_value}")
  println("   评估次数: \{kh_result.evaluations}")
  println("")

  println("26. 运行帝国主义竞争算法 (ICA):")
  let ica_config = @lib.make_ica_config(1000, dim, bounds, 25)
  let ica_result = @lib.imperialist_competitive_algorithm(ica_config, @lib.sphere_function, rng)
  println("   最优值: \{ica_result.best_value}")
  println("   评估次数: \{ica_result.evaluations}")
  println("")

  println("27. 运行随机分形搜索 (SFS):")
  let sfs_config = @lib.make_sfs_config(1000, dim, bounds, 25)
  let sfs_result = @lib.stochastic_fractal_search(sfs_config, @lib.sphere_function, rng)
  println("   最优值: \{sfs_result.best_value}")
  println("   评估次数: \{sfs_result.evaluations}")
  println("")

  println("28. 运行共生生物搜索 (SOS):")
  let sos_config = @lib.make_sos_config(1000, dim, bounds, 25)
  let sos_result = @lib.symbiotic_organisms_search(sos_config, @lib.sphere_function, rng)
  println("   最优值: \{sos_result.best_value}")
  println("   评估次数: \{sos_result.evaluations}")
  println("")

  println("29. 运行生物地理学优化 (BBO):")
  let bbo_config = @lib.make_bbo_config(1000, dim, bounds, 25, 0.01)
  let bbo_result = @lib.biogeography_based_optimization(bbo_config, @lib.sphere_function, rng)
  println("   最优值: \{bbo_result.best_value}")
  println("   评估次数: \{bbo_result.evaluations}")
  println("")

  println("30. 运行大象牧群优化 (EHO):")
  let eho_config = @lib.make_eho_config(1000, dim, bounds, 25, 5, 0.5)
  let eho_result = @lib.elephant_herding_optimization(eho_config, @lib.sphere_function, rng)
  println("   最优值: \{eho_result.best_value}")
  println("   评估次数: \{eho_result.evaluations}")
  println("")

  println("31. 运行均衡优化 (EO):")
  let eo_config = @lib.make_eo_config(1000, dim, bounds, 25)
  let eo_result = @lib.equilibrium_optimizer(eo_config, @lib.sphere_function, rng)
  println("   最优值: \{eo_result.best_value}")
  println("   评估次数: \{eo_result.evaluations}")
  println("")

  println("32. 运行风驱动优化 (WDO):")
  let wdo_config = @lib.make_wdo_config(1000, dim, bounds, 25)
  let wdo_result = @lib.wind_driven_optimization(wdo_config, @lib.sphere_function, rng)
  println("   最优值: \{wdo_result.best_value}")
  println("   评估次数: \{wdo_result.evaluations}")
  println("")

  println("33. 运行飞蛾搜索算法 (MSA):")
  let msa_config = @lib.make_msa_config(1000, dim, bounds, 25)
  let msa_result = @lib.moth_search_algorithm(msa_config, @lib.sphere_function, rng)
  println("   最优值: \{msa_result.best_value}")
  println("   评估次数: \{msa_result.evaluations}")
  println("")

  println("34. 运行路径finder算法 (PFA):")
  let pfa_config = @lib.make_pfa_config(1000, dim, bounds, 25)
  let pfa_result = @lib.pathfinder_algorithm(pfa_config, @lib.sphere_function, rng)
  println("   最优值: \{pfa_result.best_value}")
  println("   评估次数: \{pfa_result.evaluations}")
  println("")

  println("35. 运行菌落捕食算法 (CPA):")
  let cpa_config = @lib.make_cpa_config(1000, dim, bounds, 25)
  let cpa_result = @lib.colony_predation_algorithm(cpa_config, @lib.sphere_function, rng)
  println("   最优值: \{cpa_result.best_value}")
  println("   评估次数: \{cpa_result.evaluations}")
  println("")

  println("36. 运行细菌菌落优化 (BCO):")
  let bco_config = @lib.make_bco_config(1000, dim, bounds, 25)
  let bco_result = @lib.bacteria_colony_optimization(bco_config, @lib.sphere_function, rng)
  println("   最优值: \{bco_result.best_value}")
  println("   评估次数: \{bco_result.evaluations}")
  println("")

  println("37. 运行飞狐优化算法 (FFOA):")
  let ffoa_config = @lib.make_ffoa_config(1000, dim, bounds, 25)
  let ffoa_result = @lib.flying_fox_optimization(ffoa_config, @lib.sphere_function, rng)
  println("   最优值: \{ffoa_result.best_value}")
  println("   评估次数: \{ffoa_result.evaluations}")
  println("")

  println("38. 比较不同评估预算下的性能:")
  let results = @lib.run_benchmark_at_evals(
    @lib.sphere_function,
    "Sphere Function",
    dim,
    bounds,
    0.0,
    5000,
    rng
  )
  @lib.print_benchmark_table(results, "Sphere Function", 5000)
}